name: Extract Backup Zip Directly

on:
  workflow_dispatch: # يتيح لك التشغيل اليدوي من تبويب Actions

jobs:
  extract:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Clean and Extract to .github
        run: |
          echo "=== 1. الانتقال إلى مجلد .github وتنظيف المحتويات القديمة ==="
          cd .github
          
          # حذف كل شيء ما عدا ملف الـ ZIP ومجلد workflows
          find . -maxdepth 1 ! -name '.' ! -name '..' ! -name 'SmgBackup.zip' ! -name 'workflows' -exec rm -rf {} +

          echo "=== 2. فك ضغط الملف مباشرة داخل مجلد .github ==="
          # فك الضغط مباشرة هنا مع تخطي أو استبدال الملفات حسب الحاجة
          unzip -q SmgBackup.zip
          
          echo "=== 3. حفظ التغييرات ورفعها للمستودع ==="
          cd ..
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add .
          git commit -m "Auto-extract SmgBackup.zip directly into .github" || echo "No changes to commit"
          git push
